# The build environment for the release tarball.
#
#   podman build -t sdrtop-build -f packaging/Containerfile .
#
# The only reason this is a container and not the CI runner: glibc is forward
# compatible only, so a binary is usable on every distribution at least as new
# as the one that built it and on none that are older. Debian 12 puts the floor
# at glibc 2.36, which reaches Debian 12 and 13, Ubuntu 22.04 and up, Mint,
# Kali and Raspberry Pi OS Bookworm. Built on the runner's Ubuntu 24.04 it would
# demand glibc 2.39 and lose the older half for nothing.
#
# glibc is not the only floor, and packaging/install.sh is what handles the
# other one. The binary also needs librtlsdr.so.0, which Debian ships (through
# trixie, as `librtlsdr0`) but Ubuntu does not (it packages the same upstream as
# `librtlsdr2`, soname .so.2). install.sh runs `ldd` over the downloaded binary
# and builds from source when that check fails, so the tarball never has to be
# the answer everywhere. See dev_docs/release-packaging-plan.md.
FROM docker.io/library/debian:12

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_TERM_COLOR=never

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
        curl ca-certificates build-essential pkg-config \
        libhackrf-dev librtlsdr-dev \
 && rm -rf /var/lib/apt/lists/*

# Debian ships rustc 1.63; sdrtop needs 1.88 (`slice::as_chunks`). The distro
# compiler gets past the lockfile and then fails on the source, which is the
# two-stage failure the troubleshooting page warns users about.
#
# Pinned to an exact version rather than `stable`, and only here. Two builds of
# one commit six weeks apart would otherwise use two different compilers and
# produce two different binaries, which makes the reproducible-build work in R6
# unreachable before it starts.
#
# The pin lives in this file and nowhere else, deliberately. A repo-level
# rust-toolchain.toml would also bind CI and every contributor, and it would
# silently override the MSRV job's 1.88 with this version, turning that job into
# a second copy of the stable one. What sdrtop actually promises is a floor
# (rust-version = "1.88", checked in CI) and a reproducible release build (this
# line). Those are different jobs and they get different mechanisms.
#
# Bumping it is a deliberate act: it changes the released binary's bytes.
ENV RUST_VERSION=1.98.0
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" \
 && chmod -R a+w "$CARGO_HOME"

RUN rustc --version
